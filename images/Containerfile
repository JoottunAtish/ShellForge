# Shellforge sandbox image.
#
# One build, two artifacts:
#   - the OCI image used by DockerRuntime on Linux and macOS
#   - a rootfs tarball, produced by `docker export`, imported by WslRuntime on
#     Windows via `wsl --import`
#
# One source of truth matters here. If the two diverge, a level passes on Linux
# and fails on Windows for reasons nobody can reproduce.
#
# Build:   make image
# Export:  make rootfs

FROM debian:bookworm-slim

# Deterministic and reproducible. The learner must see byte-identical starting
# state on every machine, and a level that depends on locale collation or the
# local timezone is a level that fails in CI at midnight.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    DEBIAN_FRONTEND=noninteractive

# Put documentation back before installing anything.
#
# Debian slim images ship a dpkg configuration fragment full of `path-exclude`
# lines that discard man pages, and once a package is unpacked under those rules
# its documentation is simply not on disk. The fragment's filename has varied
# across base images and over time (`docker`, `docker-nodoc`, `excludes`), so
# this finds it by content rather than guessing the name. Guessing the name is
# exactly how this silently failed the first time.
#
# This has to be its own layer, ahead of every apt-get install below.
RUN set -eux; \
    grep -rl 'path-exclude' /etc/dpkg/dpkg.cfg.d/ 2>/dev/null | xargs -r rm -fv; \
    if grep -rq 'path-exclude' /etc/dpkg/dpkg.cfg.d/ 2>/dev/null; then \
        echo "FATAL: a path-exclude rule survived, man pages would be stripped"; \
        grep -r 'path-exclude' /etc/dpkg/dpkg.cfg.d/; \
        exit 1; \
    fi

# The toolset the curriculum actually teaches.
#
# Do NOT strip man pages. Reading `man` is level 4, the single most valuable
# level in the game, and everything after it assumes the learner can read a
# manual. The layer above removes the exclusion rules and the layer below
# reinstalls the base packages so their pages land.
#
# `vim` and not `vim-tiny`, deliberately deviating from the toolset list in
# docs/design/ARCHITECTURE.md section 4.4. On Debian, vim-tiny installs
# /usr/bin/vim.tiny and provides `vi` through alternatives, but it never
# provides a `vim` command. Success criterion 5 in the project brief and the
# Day 1 exit criteria both require `vim` itself to work inside the instrumented
# shell, and a beginner typing `vim` and getting "command not found" is exactly
# the friction this project exists to remove. Costs roughly 30 MB against a
# 2.5 GB budget. `nano` stays, because someone who lands in an editor by
# accident needs an obvious way out.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        bash-completion \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        diffutils \
        less \
        nano \
        vim \
        tree \
        jq \
        file \
        procps \
        psmisc \
        htop \
        cron \
        ca-certificates \
        curl \
        git \
        openssh-client \
        sudo \
        man-db \
        manpages \
        tzdata \
    ; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Reinstall the packages that came with the base image.
#
# coreutils, grep, sed and findutils were unpacked while the path-exclude rules
# were still in force, so their man pages are not on disk no matter what we do
# afterwards. Reinstalling is the only way to get them back.
#
# The assertions at the end fail the BUILD rather than shipping an image where
# level 4 is unplayable. Catching this in CI was already too late once.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --reinstall --no-install-recommends \
        coreutils findutils grep sed bash; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    mandb -q; \
    for page in man1/ls.1.gz man1/grep.1.gz man1/find.1.gz man1/chmod.1.gz; do \
        test -f "/usr/share/man/$page" || { echo "FATAL: /usr/share/man/$page is missing"; exit 1; }; \
    done; \
    man ls >/dev/null 2>&1 || { echo "FATAL: 'man ls' does not work, level nav-04 would be unplayable"; exit 1; }; \
    echo "OK: man pages present and 'man ls' works"

# The learner. uid 1000 so file ownership matches on a bind mount and so `id`
# shows something familiar in level 20.
#
# The sudoers grant below is inert, and that is deliberate rather than an
# oversight. DockerRuntime creates the container with --security-opt
# no-new-privileges, which stops sudo from gaining privilege at all, so
# `sudo anything` fails here no matter what this file says.
# cmd/shellforge/isolation_test.go's TestSudoIsRefusedByNoNewPrivileges pins
# that, and issue #152 took the decision it asked for: the curriculum teaches
# what sudo is and why this box withholds it, and every Act V and Act VI
# objective is reachable by an unprivileged learner. The flag stays. The grant
# stays too, because removing it would make the refusal a "command not found"
# rather than the honest "the no new privileges flag is set" a learner can look
# up. Do not remove the flag to make a level pass.
#
# learner joins the logistics group at build time. perm-02 asks the learner to
# regroup a file they own, and a user may chgrp only to a group they already
# belong to, so an empty logistics group makes that objective unreachable by
# any command an unprivileged learner can run. The CI image job asserts the
# membership, in the same style as the `man ls` assertion above.
RUN set -eux; \
    groupadd --gid 1000 learner; \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash learner; \
    echo 'learner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/learner; \
    chmod 0440 /etc/sudoers.d/learner; \
    groupadd --gid 1100 logistics; \
    usermod -aG logistics learner

# SF_STATE: the journal, the snapshots, the sentinels, and the control
# channel FIFOs, all inside the learner's own home rather than under
# /opt/shellforge. /opt/shellforge is not a host bind mount on this backend
# today, but CLAUDE.md's non-negotiable number 2 says it is the one host
# mount and it is read-only, and the WSL backend plus the Day 3 decision
# make that literally true. A state directory living there would stop being
# writable the day that happens. Mode 0755, not 0700: the security skill's
# 0700 rule governs a HOST state directory under internal/platform, where
# other users of the machine exist; inside this sandbox the learner is the
# only human, and a directory in a home tree that PushFiles might otherwise
# touch is honestly 0755 rather than pretending to be 0700.
RUN set -eux; \
    mkdir -p /home/learner/.shellforge; \
    chown -R learner:learner /home/learner/.shellforge; \
    chmod 0755 /home/learner/.shellforge

# Game mount point. Bind-mounted read-only at run time and holding the
# instrumentation rc file, the in-sandbox shims, and the level payload.
# This is the ONLY host path visible inside the sandbox. If that bind mount
# ever covers this whole directory on the Docker backend rather than a
# narrower subpath, it would shadow the baked-in files below for a live
# Docker container; it does not affect the WSL rootfs tarball, which is a
# plain filesystem export of this image with no runtime mount involved.
#
# .sandbox-id is a fixed identifying marker, owned root and mode 0444, so a
# process running as learner can read it but never rewrite it; deletion is
# blocked by this directory staying root-owned mode 0755 below, not by the
# file's own mode. The WSL destroy path (issue #69) checks for this file
# before it unregisters a distribution, and refuses when it is absent, so a
# marker a learner could delete would be a hole in that refusal rather than
# a safety net. Presence is the contract, not this exact string: the
# destructive-safety skill asks for confirmation that a marker file exists,
# not that it holds a specific value. The v1 suffix is future proofing in
# case the marker format itself needs to change in a way #69's check would
# need to tell apart, not a value anything reads today.
RUN set -eux; \
    mkdir -p /opt/shellforge/bin /opt/shellforge/rc; \
    printf 'shellforge-sandbox-v1\n' > /opt/shellforge/.sandbox-id; \
    chown -R root:root /opt/shellforge; \
    chmod 0755 /opt/shellforge; \
    chmod 0444 /opt/shellforge/.sandbox-id

# --chmod on every COPY below, so a file's mode comes from this file and not
# from whatever filesystem the build host read the checkout through.
#
# Without it one Containerfile produced two different images. On Windows the
# checkout reports 0755; built from the same checkout through WSL, where
# /mnt/d is drvfs with metadata off, every file reports 0777. COPY carries the
# source mode into the layer, so every layer from the first COPY onward had a
# different digest depending on which shell ran `make image`, and the sandbox
# container was replaced each time a developer switched. The header of this
# file promises a byte-identical starting state on every machine, and that
# promise has to survive the build host too.
#
# It also mattered on its own for wsl.conf below, which came out
# world-writable on the WSL path. That file is what turns automount and
# interop off, which is the mechanism behind the promise that a learner cannot
# reach their own files, and `make rootfs` exports this image as the WSL
# distribution. A file any user in the distribution can rewrite is not a
# guarantee.
COPY --chmod=0644 rc/instrument.bash /opt/shellforge/rc/instrument.bash
COPY --chmod=0755 bin/ /opt/shellforge/bin/

# WSL reads this on import. It is written again by WslRuntime after import
# because the values matter enough to verify rather than assume, but baking it
# in means a manually imported rootfs behaves correctly too.
#
# automount off:          no /mnt/c, so the learner cannot reach their real files
# interop off:            cannot launch notepad.exe from bash
# appendWindowsPath off:  $PATH is not polluted with 300 Windows entries, which
#                         would make every PATH lesson nonsense
COPY --chmod=0644 wsl.conf /etc/wsl.conf

USER learner
WORKDIR /home/learner

# PID 1 sleeps and reaps. The learner's shell arrives via `docker exec -it`,
# which keeps the container alive independently of any one session and makes
# reset a matter of recreating the container from the pristine image.
#
# It is not `sleep infinity`. An orphaned process is re-parented to PID 1, and
# a PID 1 that never calls wait leaves it as a zombie for the life of the
# container, which matters here because Act V teaches the learner to background
# a process and kill it. bash reaps what the kernel hands it. The reasoning is
# in full on sandboxInit in internal/runtime/docker/docker.go, which passes the
# same command explicitly on `docker run` and is what the Docker backend
# actually uses; this CMD is what a manually started container gets.
CMD ["bash", "-c", "trap 'exit 0' TERM INT; while :; do sleep infinity & wait $!; done"]
